<Window x:Class="DocuMind.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DocuMind.UI.ViewModels"
        xmlns:converters="clr-namespace:DocuMind.UI.Converters"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        mc:Ignorable="d"
        Title="DocuMind Pro Studio" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Segoe UI"
        AllowDrop="True" Drop="Grid_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,25,20,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Bookshelf" Foreground="#6C5CE7" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Kütüphane" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" Foreground="#2D3436"/>
                    </StackPanel>
                    <Button Command="{Binding UploadFileCommand}" 
                            Margin="0,15,0,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#6C5CE7" BorderBrush="{x:Null}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePlusOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="YENİ DÖKÜMAN EKLE"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewChatCommand}"
                            Margin="0,8,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChatPlusOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="BOŞ SOHBET"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBox Grid.Row="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Döküman veya Etiket Ara..."
                         Margin="15,5,15,15"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:TextFieldAssist.HasClearButton="True"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding ChatHistory}" SelectedItem="{Binding SelectedHistoryItem}" 
                         Background="Transparent" BorderThickness="0" Padding="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="materialDesign:ListBoxItemAssist.CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="Gray" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Tags, TargetNullValue='Etiket Yok'}" FontSize="10" Foreground="#6C5CE7" FontStyle="Italic"/>
                                </StackPanel>
                                <Button Grid.Column="2" 
                                        Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignToolButton}" Height="20" Width="20" Padding="0">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#FF7675"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F5F6FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="White" Padding="20,15" Effect="{StaticResource MaterialDesignShadowDepth1}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Robot" Width="24" Height="24" Foreground="#00B894" VerticalAlignment="Center"/>
                    <StackPanel Margin="15,0,0,0">
                        <TextBlock Text="{Binding LoadedFileName, TargetNullValue='Hoş Geldiniz'}" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436"/>
                        <TextBlock Text="{Binding SelectedProvider}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="ChatScroller" Padding="15">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Border HorizontalAlignment="Right" Background="#6C5CE7" CornerRadius="15,15,0,15" Padding="15,10" 
                                            Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="600">
                                        <TextBlock Text="{Binding Content}" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
                                    </Border>

                                    <Border HorizontalAlignment="Left" Background="White" CornerRadius="0,15,15,15" Padding="15,10" 
                                            Visibility="{Binding IsUser, Converter={StaticResource InverseBooleanToVisibilityConverter}}" MaxWidth="750">
                                        <StackPanel>
                                            <markdig:MarkdownViewer Markdown="{Binding Content}"/>
                                            <Button Click="CopyMessage_Click" 
                                                    HorizontalAlignment="Right" 
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Margin="0,5,0,0" ToolTip="Kopyala">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Foreground="LightGray"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" IsIndeterminate="True" Width="30" Height="30" Margin="0,20"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" Padding="15" Margin="20" CornerRadius="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding UserQuestion, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Döküman hakkında soru sorun..." BorderThickness="0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Command="{Binding SendMessageCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Background="#6C5CE7" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Send"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#FDFDFD" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="KONTROL MERKEZİ" Foreground="#B2BEC3" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                    <materialDesign:Card Margin="0,0,0,15" Background="White" UniformCornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Yapay Zeka Ayarları" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" Margin="0,0,0,10" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            <ComboBox ItemsSource="{Binding ModelVersions}" SelectedItem="{Binding SelectedModelVersion}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Text="{Binding ApiKeyInput}" materialDesign:HintAssist.Hint="API Anahtarı" Margin="0,10,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveApiKeyCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Command="{Binding SaveApiKeyCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Kaydet"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding TestApiConnectionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Connection" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Test Et"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding ApiConnectionStatus}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="0,0,0,15" Background="White" UniformCornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Uzmanlık Modu (Persona)" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" DisplayMemberPath="Name" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                <Button Grid.Column="1" Command="{Binding OpenPersonaEditorCommand}" Style="{StaticResource MaterialDesignIconButton}" Margin="5,0,0,0">
                                    <materialDesign:PackIcon Kind="PlusCircle" Foreground="#6C5CE7"/>
                                </Button>
                            </Grid>
                            <Button Command="{Binding DeletePersonaCommand}" CommandParameter="{Binding SelectedPersona}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Seçili Uzmanı Sil"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="0,0,0,15" Background="#E8EAF6" UniformCornerRadius="10"
                                          Visibility="{Binding IsFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Padding="15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="ClipboardCheck" Foreground="#3F51B5"/>
                                    <TextBlock Text="DOSYA KARNESİ" FontWeight="Bold" Foreground="#3F51B5" Margin="10,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="Dosya Türü" FontSize="10" Foreground="Gray" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedHistoryItem.DocumentType, TargetNullValue='Tanımlanıyor...'}" FontSize="12" Margin="0,0,0,8" FontWeight="SemiBold"/>

                                <TextBlock Text="Özet" FontSize="10" Foreground="Gray" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedHistoryItem.Summary, TargetNullValue='Analiz yapılıyor...'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" FontStyle="Italic"/>

                                <TextBlock Text="Anahtar Kavramlar" FontSize="10" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedHistoryItem.KeyConcepts}" FontSize="11" Foreground="#6C5CE7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="0,0,0,15" Background="White" UniformCornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Akıllı Brifing" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,12"/>
                            <Button Command="{Binding GenerateBriefCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#00B894" BorderBrush="{x:Null}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileChartOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Karar Brifingi Oluştur"/>
                                </StackPanel>
                            </Button>
                            <CheckBox IsChecked="{Binding RequireCitations}" Margin="0,10,0,0" Content="Cevaplarda sayfa kanıtı iste"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <TextBlock Text="GELİŞMİŞ ARAÇLAR" Foreground="#B2BEC3" FontSize="11" FontWeight="Bold" Margin="0,10,0,10"/>

                    <Border Background="White" Padding="12" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#EEE" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Web" Foreground="#0984E3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Web Arama" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ToggleButton IsChecked="{Binding IsWebSearchEnabled}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                            </Grid>

                            <TextBox Text="{Binding GoogleApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Google Search API Key"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding GoogleSearchEngineId, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search Engine ID (cx)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding SaveGoogleSettingsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Kaydet"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding TestWebSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Test Et"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding WebSearchStatus}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ExportChatCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,5,0,0" BorderBrush="#00B894" Foreground="#00B894">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExportOutline" Margin="0,0,8,0"/>
                            <TextBlock Text="Sohbeti Raporla"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
