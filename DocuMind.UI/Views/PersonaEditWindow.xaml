<Window x:Class="DocuMind.UI.Views.PersonaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Uzman Profili Düzenle" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="YENİ UZMAN EKLE" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#6C5CE7"/>

            <materialDesign:Card Padding="15" UniformCornerRadius="10">
                <StackPanel>
                    <TextBox x:Name="TxtName" materialDesign:HintAssist.Hint="Uzmanlık Adı (Örn: TUS Hocası)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                    <ComboBox x:Name="CmbIcon" materialDesign:HintAssist.Hint="İkon Seçin" 
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,15">
                        <ComboBoxItem Content="Robot" Tag="Robot" IsSelected="True"/>
                        <ComboBoxItem Content="School" Tag="School"/>
                        <ComboBoxItem Content="ScaleBalance" Tag="ScaleBalance"/>
                        <ComboBoxItem Content="Stethoscope" Tag="Stethoscope"/>
                        <ComboBoxItem Content="CodeBraces" Tag="CodeBraces"/>
                    </ComboBox>

                    <TextBox x:Name="TxtDescription" materialDesign:HintAssist.Hint="Kısa Açıklama" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                    <TextBox x:Name="TxtSystemPrompt" materialDesign:HintAssist.Hint="Yapay Zeka Talimatları (System Prompt)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="İPTAL" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="KAYDET" Click="Save_Click" Background="#6C5CE7" BorderBrush="{x:Null}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
