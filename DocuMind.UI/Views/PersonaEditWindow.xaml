<Window x:Class="DocuMind.UI.Views.PersonaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Uzman Profili Düzenle" Height="530" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F9FAFB" FontFamily="Segoe UI">

    <Grid Margin="25">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <materialDesign:PackIcon Kind="AccountTieOutline" Foreground="#4F46E5" Width="28" Height="28" VerticalAlignment="Center"/>
                <TextBlock Text="YENİ UZMAN EKLE" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" Foreground="#111827" VerticalAlignment="Center"/>
            </StackPanel>

            <materialDesign:Card Padding="20" UniformCornerRadius="12" Background="#FFFFFF" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBox x:Name="TxtName" materialDesign:HintAssist.Hint="Uzmanlık Adı (Örn: Hukuk Danışmanı)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,18"
                              FontSize="15"/>

                    <ComboBox x:Name="CmbIcon" materialDesign:HintAssist.Hint="İkon Seçin" 
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,18"
                               FontSize="15">
                        <ComboBoxItem Content="Robot" Tag="Robot" IsSelected="True"/>
                        <ComboBoxItem Content="School" Tag="School"/>
                        <ComboBoxItem Content="ScaleBalance" Tag="ScaleBalance"/>
                        <ComboBoxItem Content="Stethoscope" Tag="Stethoscope"/>
                        <ComboBoxItem Content="CodeBraces" Tag="CodeBraces"/>
                    </ComboBox>

                    <TextBox x:Name="TxtDescription" materialDesign:HintAssist.Hint="Kısa Açıklama" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,18"
                              FontSize="15"/>

                    <TextBox x:Name="TxtSystemPrompt" materialDesign:HintAssist.Hint="Yapay Zeka Talimatları (System Prompt)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                              FontSize="14"
                             AcceptsReturn="True" Height="130" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button Content="İPTAL" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#6B7280" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <Button Content="KAYDET" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4F46E5" BorderBrush="{x:Null}" materialDesign:ButtonAssist.CornerRadius="8" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
